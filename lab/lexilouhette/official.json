  "definitions": {
    "peul": {"index":2,"text":"Langue parlée dans plusieurs pays de l’Afrique de l’Ouest."},
    "prolo": {"index":1,"text":"(Très familier) Prolétaire."},
    "bidon": {"index":3,"text":"Récipient en fer-blanc, en plastique, etc., clos hermétiquement, renfermant de l’huile, du pétrole, de l’essence, du lait, etc."},
    "bénin": {"index":3,"text":"(Médecine) Qui n’est pas alarmant."},
    "bedon": {"index":1,"text":"(Familier) Bedaine, ventre replet."},
    "boxon": {"index":2,"text":"(Argot) Établissement où se pratique la prostitution, maison close. Tu vas quitter ta bonne mèrePour t’en aller dans un boxon.Je ne te retiens pas, ma chère,Si c’est là ta vocation. — (Anonyme, « Adieu ! Fais-toi putain », dans Le Bréviaire du carabin, 1976)"},
    "cancre": {"index":2,"text":"(Sens figuré) Personne (morale ou physique) qui, dans un groupe, réussit le moins bien (ou échoue)."},
    "foncer": {"index":3,"text":"(Sens figuré) Charger de couleur de manière à rendre plus sombre."},
    "joncher": {"index":1,"text":"(Sens figuré) Épandre une grande quantité d’objets de façon éparse."},
    "lancée": {"index":1,"text":"Direction générale d'une action, élan, essor."},
    "manche": {"index":7,"text":"Partie préhensible d’un instrument, d’un outil, par laquelle on le tient pour en faire usage."},
    "rincer": {"index":4,"text":"Faire un dernier lavage dans de l’eau sans savon, éventuellement à un pH non neutre, comme dernière opération pour évacuer les agents de nettoyage."},
    "tanche": {"index":1,"text":"(Argot) Idiot."},
    "arborer": {"index":1,"text":"(Sens figuré) Montrer avec ostentation face à quelqu'un."},
    "cavale": {"index":1,"text":"(Argot policier) Évasion, fuite d’une personne détenue en prison."},
    "lavabo": {"index":2,"text":"(Ordinairement) Dispositif mobile garni d’une cuvette et d’un pot à eau ou d’une cuvette fixe, surmontée de robinets et dotée d’un trou d’évacuation d’eau et destinée à se laver."},
    "ravage": {"index":1,"text":"Dommage, dégât fait avec violence et rapidité."}
  }
